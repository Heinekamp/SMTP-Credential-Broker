# Copy to .env and fill in real values. Never commit the real .env file.
#
# Upstream SMTP account credentials are managed through the web UI / API,
# not through this file or docker-compose.yml (spec §23) — nothing here
# should ever hold a provider password.

# Every RELAY_* setting in docs/configuration.md can be set here — the app
# container loads this whole file. Times are stored and logged in UTC and
# shown in each browser's own local time; there's no time zone to set.

# --- Application ---
# Secure (HTTPS-only) session cookies. Keep true behind an HTTPS reverse
# proxy. If you open the console as plain http://<host>:8000 (a trusted
# LAN only), set this to false — browsers won't keep a secure cookie on a
# plain-HTTP page, so you'd never stay logged in.
RELAY_COOKIE_SECURE=true

# The relay's own hostname — what local SMTP users are told to connect to
# (the Connection Details view) and Postfix's own SMTP identity
# (myhostname in the generated main.cf). Read by BOTH the app and postfix
# services in docker-compose.yml — they must agree on this value, since
# it's also the Cyrus SASL realm saslpasswd2 stores credentials under.
RELAY_SUBMISSION_HOST=smtp-relay.internal

# Host-side port the admin console/API is published on (container-side is
# always 8000). Uncomment and change if 8000 is already taken by
# something else on the host.
# APP_HOST_PORT=8000

# --- Secrets ---
# Required before any upstream account can be created — generate with:
#   docker compose run --rm app relay generate-encryption-key
# There is no recovery if this is lost; back it up separately from the
# database (security-model.md §2). Prefer RELAY_ENCRYPTION_KEY_FILE
# (a mounted Docker secret) over the plain env var in production.
# RELAY_ENCRYPTION_KEY=
# RELAY_ENCRYPTION_KEY_FILE=/run/secrets/relay_encryption_key

# Host address the SMTP submission port (587) is published on. Default:
# every interface. On a host with a public interface, set this to the LAN
# address your internal services use.
# SUBMISSION_BIND_ADDRESS=192.168.1.10

# SMTP AUTH attempts allowed per client IP per minute (0 = no limit).
# RELAY_SUBMISSION_AUTH_RATE_LIMIT_PER_MINUTE=60
