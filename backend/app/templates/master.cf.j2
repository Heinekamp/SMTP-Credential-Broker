{#- A per-service `-o inet_interfaces=loopback-only` override does NOT
   restrict this service's own listener bind — inet_interfaces controls
   master's socket bind and isn't one of the parameters master re-reads
   per service the way smtpd-level parameters are (confirmed by testing:
   the override was silently ignored and port 25 stayed reachable from
   outside). Binding a specific address is instead done by putting it
   directly in the service-name column. #}
127.0.0.1:smtp inet n  -       n       -       -       smtpd
submission inet n       -       n       -       -       smtpd
  -o syslog_name=postfix/submission
  -o smtpd_tls_security_level=encrypt
  -o smtpd_tls_auth_only=yes
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_sender_restrictions=reject_sender_login_mismatch
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject_unauth_destination
  -o milter_macro_daemon_name=ORIGINATING
pickup    unix  n       -       n       60      1       pickup
cleanup   unix  n       -       n       -       0       cleanup
qmgr      unix  n       -       n       300     1       qmgr
tlsmgr    unix  -       -       n       1000?   1       tlsmgr
rewrite   unix  -       -       n       -       -       trivial-rewrite
bounce    unix  -       -       n       -       0       bounce
defer     unix  -       -       n       -       0       bounce
trace     unix  -       -       n       -       0       bounce
verify    unix  -       -       n       -       1       verify
flush     unix  n       -       n       1000?   0       flush
proxymap  unix  -       -       n       -       -       proxymap
proxywrite unix -       -       n       -       1       proxymap
smtp      unix  -       -       n       -       -       smtp
relay     unix  -       -       n       -       -       smtp
  -o syslog_name=postfix/$service_name
{#- Implicit-TLS (wrapped) upstream accounts, e.g. port 465, need
   smtp_tls_wrappermode — Postfix can only set that per-transport, not
   per-destination, so senders using an implicit-TLS upstream account
   are routed here instead of the default `smtp` transport via
   sender_dependent_default_transport_maps (main.cf.j2), with the
   nexthop left empty there so it still resolves through
   sender_relayhost like every other sender. Discovered broken in a
   real deployment: without this, Postfix waits for a plaintext
   greeting on a port that immediately expects a TLS ClientHello,
   failing with "lost connection ... while receiving the initial
   server greeting" (postfix-architecture.md §4). #}
smtp_implicit_tls unix  -       -       n       -       -       smtp
  -o syslog_name=postfix/$service_name
  -o smtp_tls_wrappermode=yes
  -o smtp_tls_security_level=encrypt
showq     unix  n       -       n       -       -       showq
error     unix  -       -       n       -       -       error
retry     unix  -       -       n       -       -       error
discard   unix  -       -       n       -       -       discard
local     unix  -       n       n       -       -       local
virtual   unix  -       n       n       -       -       virtual
lmtp      unix  -       -       n       -       -       lmtp
anvil     unix  -       -       n       -       1       anvil
scache    unix  -       -       n       -       1       scache
{#- Required since Postfix 3.4 whenever maillog_file is set (main.cf.j2) —
   without it, `postfix start`'s own integrity check refuses to start at
   all ("missing 'postlog' service in master.cf"). Found by hitting that
   exact fatal error against a real Postfix instance. #}
postlog   unix-dgram n  -       n       -       1       postlogd
