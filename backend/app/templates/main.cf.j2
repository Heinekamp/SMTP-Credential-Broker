{# Generated by the SMTP Credential Broker config generator — do not edit by
   hand, changes are overwritten on the next generation. See
   docs/postfix-architecture.md for the full explanation of every
   directive below. #}

# ── Logging ──────────────────────────────────────────────────────────
# This container has no syslog daemon — without this, every Postfix log
# line (including fatal startup/reload errors) silently vanishes. Postfix
# 3.4+ can log directly to a file/pipe instead of syslog. A real file
# (rather than /dev/stdout directly) is required so the control surface's
# `tail_maillog` op (security-model.md §6) has something seekable to read
# for mail_log ingestion (docs/postfix-architecture.md §9) — the
# entrypoint separately `tail -F`s this file to stdout so `docker compose
# logs postfix` keeps working as the operator's live log view too.
maillog_file = /var/log/postfix/maillog

# ── Identity / posture ──────────────────────────────────────────────
myhostname = {{ myhostname }}
mydomain = {{ mydomain }}
myorigin = $mydomain
inet_interfaces = all
inet_protocols = ipv4
mynetworks = 127.0.0.0/8
mydestination =
relay_domains =
local_transport = error:local mail delivery is disabled on this relay
# No local delivery, so no aliases. The defaults (hash:/etc/aliases,
# nis:mail.aliases) made every smtpd connection log an aliases.db error and
# a NIS warning into the maillog (#228).
alias_maps =
alias_database =

# ── Client-facing (smtpd) TLS ───────────────────────────────────────
smtpd_tls_cert_file = /etc/postfix/tls/relay.crt
smtpd_tls_key_file = /etc/postfix/tls/relay.key
smtpd_tls_security_level = encrypt
smtpd_tls_auth_only = yes
smtpd_tls_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1
smtpd_tls_mandatory_ciphers = high

# ── Client-facing (smtpd) SASL ──────────────────────────────────────
smtpd_sasl_type = cyrus
smtpd_sasl_path = smtpd
smtpd_sasl_auth_enable = yes
smtpd_sasl_security_options = noanonymous
smtpd_sasl_local_domain =
broken_sasl_auth_clients = yes

# ── Sender authorization (the core invariant) ───────────────────────
smtpd_sender_login_maps = lmdb:/etc/postfix/relay/sender_login
# reject_sender_login_mismatch doesn't apply to the null sender at all,
# so `MAIL FROM:<>` from any authenticated user would otherwise pass with
# an arbitrary From: header (#151). Nothing legitimate submits bounces
# through this relay — refuse it outright. Shared with master.cf's
# submission service via $relay_sender_restrictions so both stay in step.
relay_sender_restrictions =
    check_sender_access inline:{ { <> = REJECT The null sender is not accepted from authenticated clients } }
    reject_sender_login_mismatch
smtpd_sender_restrictions = $relay_sender_restrictions
smtpd_relay_restrictions =
    permit_sasl_authenticated
    reject
smtpd_recipient_restrictions =
    permit_sasl_authenticated
    reject_unauth_destination
smtpd_helo_required = yes
# Brute-force limits for SMTP AUTH (#171). anvil counts AUTH commands per
# client IP per minute; many internal services can share one IP behind
# Docker/NAT, so the default (RELAY_SUBMISSION_AUTH_RATE_LIMIT_PER_MINUTE)
# is generous. Within one session, every failed AUTH is an error: after 2
# Postfix starts sleeping between replies, after 5 it disconnects —
# instead of its default 20 guesses per connection.
smtpd_client_auth_rate_limit = {{ submission_auth_rate_limit_per_minute }}
anvil_rate_time_unit = 60s
smtpd_soft_error_limit = 2
smtpd_hard_error_limit = 5
# Enforces LocalSmtpUser.rate_limit_per_hour, keyed on sasl_username —
# Postfix's own anvil limiter only keys on client IP, which can't tell
# local users sharing one apart. Once per message (not per recipient),
# hence end-of-data rather than the recipient restrictions above.
# core/rate_limit_policy.py runs this inside the `app` container itself.
smtpd_end_of_data_restrictions =
    check_policy_service inet:app:{{ policy_service_port }}
# Fail open when the policy service can't be reached at all — `app` down,
# restarting or crash-looping. Postfix's own default is to wait 100s and
# then tempfail *every* message ("451 4.3.5 Server configuration
# problem"), turning a rate-limiter outage into a mail outage
# (security-model.md §10, #167). Rate limiting is abuse mitigation, not an
# authorization boundary — sender authorization above is unaffected.
smtpd_policy_service_default_action = DUNNO
smtpd_policy_service_timeout = 10s

# ── Upstream (smtp client) TLS ──────────────────────────────────────
# `secure` = TLS is mandatory AND the upstream's certificate must chain to
# smtp_tls_CAfile and match the nexthop hostname (smtp_tls_secure_cert_match's
# default "nexthop, dot-nexthop"). `encrypt` alone verifies nothing, so
# anyone able to intercept the connection would receive AUTH PLAIN with
# the real upstream password. Accounts that opted out of verification
# (UpstreamAccount.tls_skip_verify) get `encrypt` via smtp_tls_policy_maps,
# keyed by their [host]:port nexthop.
smtp_tls_security_level = secure
smtp_tls_policy_maps = lmdb:/etc/postfix/relay/tls_policy
smtp_tls_CAfile = {{ upstream_tls_ca_file }}
smtp_tls_loglevel = 1

# ── Upstream selection / sender-dependent authentication ────────────
smtp_sender_dependent_authentication = yes
sender_dependent_relayhost_maps = lmdb:/etc/postfix/relay/sender_relayhost
# Routes senders with an implicit-TLS (wrapped, e.g. port 465) upstream
# account through the wrappermode-enabled transport clone in master.cf
# instead of the default `smtp` transport — see that file's comment.
# Senders absent from this map (the STARTTLS-mode majority) fall
# through to the default transport unaffected.
sender_dependent_default_transport_maps = lmdb:/etc/postfix/relay/sender_transport
smtp_sasl_auth_enable = yes
smtp_sasl_password_maps = lmdb:/etc/postfix/relay/sasl_passwd
smtp_sasl_security_options = noanonymous
# Never deliver directly. An empty relayhost on its own means "look up the
# recipient's MX and connect to it from this host" — so any sender without
# a sender_relayhost entry used to go out direct, with no upstream account
# at all (#151). Every routed sender has an explicit sender_transport
# entry (config_generator.py), so the default transport is only ever
# reached by mail that has no legitimate route: it bounces instead. That
# includes Postfix's own bounce notices (null sender), which have no
# upstream account they could authenticate as.
relayhost =
default_transport = error:5.7.1 No upstream route for this sender
