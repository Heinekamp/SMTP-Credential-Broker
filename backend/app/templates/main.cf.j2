{# Generated by the Managed SMTP Relay config generator — do not edit by
   hand, changes are overwritten on the next generation. See
   docs/postfix-architecture.md for the full explanation of every
   directive below. #}

# ── Logging ──────────────────────────────────────────────────────────
# This container has no syslog daemon — without this, every Postfix log
# line (including fatal startup/reload errors) silently vanishes. Postfix
# 3.4+ can log directly to a file/pipe instead of syslog. A real file
# (rather than /dev/stdout directly) is required so the control surface's
# `tail_maillog` op (security-model.md §6) has something seekable to read
# for mail_log ingestion (docs/postfix-architecture.md §9) — the
# entrypoint separately `tail -F`s this file to stdout so `docker compose
# logs postfix` keeps working as the operator's live log view too.
maillog_file = /var/log/postfix/maillog

# ── Identity / posture ──────────────────────────────────────────────
myhostname = {{ myhostname }}
mydomain = {{ mydomain }}
myorigin = $mydomain
inet_interfaces = all
inet_protocols = ipv4
mynetworks = 127.0.0.0/8
mydestination =
relay_domains =
local_transport = error:local mail delivery is disabled on this relay

# ── Client-facing (smtpd) TLS ───────────────────────────────────────
smtpd_tls_cert_file = /etc/postfix/tls/relay.crt
smtpd_tls_key_file = /etc/postfix/tls/relay.key
smtpd_tls_security_level = encrypt
smtpd_tls_auth_only = yes
smtpd_tls_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1
smtpd_tls_mandatory_ciphers = high

# ── Client-facing (smtpd) SASL ──────────────────────────────────────
smtpd_sasl_type = cyrus
smtpd_sasl_path = smtpd
smtpd_sasl_auth_enable = yes
smtpd_sasl_security_options = noanonymous
smtpd_sasl_local_domain =
broken_sasl_auth_clients = yes

# ── Sender authorization (the core invariant) ───────────────────────
smtpd_sender_login_maps = lmdb:/etc/postfix/relay/sender_login
smtpd_sender_restrictions =
    reject_sender_login_mismatch
smtpd_relay_restrictions =
    permit_sasl_authenticated
    reject
smtpd_recipient_restrictions =
    permit_sasl_authenticated
    reject_unauth_destination
smtpd_helo_required = yes

# ── Upstream (smtp client) TLS ──────────────────────────────────────
smtp_tls_security_level = encrypt
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtp_tls_loglevel = 1

# ── Upstream selection / sender-dependent authentication ────────────
smtp_sender_dependent_authentication = yes
sender_dependent_relayhost_maps = lmdb:/etc/postfix/relay/sender_relayhost
# Routes senders with an implicit-TLS (wrapped, e.g. port 465) upstream
# account through the wrappermode-enabled transport clone in master.cf
# instead of the default `smtp` transport — see that file's comment.
# Senders absent from this map (the STARTTLS-mode majority) fall
# through to the default transport unaffected.
sender_dependent_default_transport_maps = lmdb:/etc/postfix/relay/sender_transport
smtp_sasl_auth_enable = yes
smtp_sasl_password_maps = lmdb:/etc/postfix/relay/sasl_passwd
smtp_sasl_security_options = noanonymous
relayhost =
